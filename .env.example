# Copy this file to .env.local for local development, and set the same
# variables in Netlify (Site settings → Environment variables) for deploys.

# MongoDB connection string (e.g. from MongoDB Atlas).
# Required for the contact form and the admin dashboard.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority"

# Password for the /admin dashboard login. Choose a strong value.
ADMIN_PASSWORD="change-me-to-a-strong-password"

# Optional: Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
